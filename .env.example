# Copia este archivo como .env (en la misma carpeta) y rellena tus datos.
# Solo hace falta para el reporte diario por correo (scrap_diario.cmd).
# Guardalo en UTF-8 SIN BOM, o la primera linea se lee mal.

# Tu cuenta de Gmail, la que envia el correo
GMAIL_USUARIO=tucorreo@gmail.com

# Contrasena de APLICACION de Google (16 letras), no la de tu cuenta:
# Cuenta de Google -> Seguridad -> Verificacion en dos pasos -> Contrasenas de aplicaciones
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# A quien le llega el reporte. Si lo dejas vacio, te llega a ti mismo.
CORREO_DESTINO=tucorreo@gmail.com
